[Unit]
Description=Research scanner: daily V3 archive scan (research-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=andrei
WorkingDirectory=/home/andrei/agent/projects/claude-scanner-cloud
EnvironmentFile=-/home/andrei/agent/data/research-collectors/current/scanner/panel/overrides/v3.env
ExecStart=/home/andrei/agent/scripts/research-scanner-v3.sh
Restart=always
RestartSec=5
# Research-only: no order placement, no credentials, no trading.

[Install]
WantedBy=multi-user.target
